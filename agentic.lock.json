    "noPrivateKeys": {
      "roots": [
        "apps"
      ],
      "allowedIn": [
        {
          "file": "apps/agent-runtime/src/config.ts",
          "why": "local-aes dev backend reads A2A_MASTER_PRIVATE_KEY only when A2A_KMS_BACKEND=local-aes; production is gcp-kms (deferred KMS migration, memory project_demo_a2a_kms_deferred)"
        },
        {
          "file": "apps/agent-runtime/scripts/canonical-a2a-e2e.ts",
          "why": "e2e harness mints an ephemeral SIWE persona; never an identity, never deployed"
        },
        {
          "file": "apps/home-mcp/src/index.ts",
          "why": "home-mcp-raw-delegate-key (findings.yaml, accepted-risk): the ask-as-me delegate key holds no authority of its own; KMS signer + client re-registration scheduled (spec 397)"
        },
        {
          "file": "apps/home/scripts/provision-demo-personas-local.ts",
          "why": "local-chain provisioner with published dev keys"
        },
        {
          "file": "apps/home/scripts/provision-service-agent-local.ts",
          "why": "local-chain provisioner with published dev keys"
        },
        {
          "file": "apps/home/scripts/provision-typed-service-agent.ts",
          "why": "one-run operator CLI; key from env, never written"
        },
        {
          "file": "apps/home/scripts/set-typed-name-records.ts",
          "why": "one-run operator CLI"
        },
        {
          "file": "apps/home/scripts/publish-capabilities.ts",
          "why": "one-run operator CLI"
        },
        {
          "file": "apps/home/scripts/link-service-steward-local.ts",
          "why": "one-run operator CLI"
        },
        {
          "file": "apps/vault/scripts/native-mcp-smoke.ts",
          "why": "dev smoke script with throwaway EOAs"
        },
        {
          "file": "apps/home/server/_lib/demo-custody.ts",
          "why": "testnet demo-persona custody from DEMO_PERSONA_KEYS"
        },
        {
          "file": "apps/home/server/connect/demo-accounts.ts",
          "why": "derives the seeded persona custodian address"
        }
      ],
      "toleratedEnvNames": [
        {
          "name": "A2A_MASTER_PRIVATE_KEY",
          "why": "the local-aes dev backend signing key; unused under gcp-kms"
        },
        {
          "name": "A2A_INTERACTIONS_SESSION_PRIVATE_KEY",
          "why": "workstation-only InteractionsDO session signer when no Cloud KMS is present"
        }
      ]
    },
    "noHmacHomeBridge": {
      "dir": "apps/home",
      "hmacCall": "bridgeInteractions",
      "sessionRpcCall": "callInteractions",
      "ceilings": {
        "hmac": 0,
        "total": 47
      }
    },
    "noCrossSubjectVaultReads": {
      "roots": [
        "apps/agent-runtime/src"
      ],
      "exemptFiles": [
        "self-only.ts"
      ],
      "gate": "subjectOfRead|routedSubjectFor"
    },
    "failOpenKnobs": {
      "roots": [
        "apps"
      ],
      "allowlist": [
        {
          "file": "apps/vault/src/index.ts",
          "knob": "allowUnboundSessionToken",
          "why": "persona/operator-key demo path (accepted testnet hole C-1, spec 248)"
        },
        {
          "file": "apps/vault/src/kas.ts",
          "knob": "allowUnsignedGrant",
          "why": "in-process self-authored grant; real authority is the spec-278 vault-key authorization"
        },
        {
          "file": "apps/vault/src/kas.ts",
          "knob": "allowUnboundGrant",
          "why": "N-4: same in-process single-use grant"
        },
        {
          "file": "apps/agent-runtime/src/index.ts",
          "knob": "developmentMode",
          "why": "test/dev session verification; production wires expectedIss/expectedAud"
        },
        {
          "file": "apps/vault/wrangler.toml",
          "knob": "DEMO_VAULT_PROVISION_ENABLED",
          "why": "registers the KEK provision route; the route is proof-gated by default"
        }
      ]
    },
    "internalMarkerSplit": {
      "src": "apps/agent-runtime/src",
      "secret": "A2A_CUSTODY_BRIDGE_SECRET",
      "marker": "x-ap-internal",
      "budget": {
        "index.ts": "unbounded",
        "interactions-do.ts": 1
