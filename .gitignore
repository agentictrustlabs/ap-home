# Every *.local.json is a local secret — a roster with private keys, a service-account file. Never committed.
*.local.json
.vercel/

# Vercel builds the Home from apps/home with the repo included; a committed root lock made pnpm link importers whose
# directories the build checkout lacks (ENOENT apps/agent-runtime/node_modules). The install resolves fresh there.
pnpm-lock.yaml
.estate-*.local
# spec 438 §5 — the judge's DELEGATE key and the wire it signs under (mint-judge-wire.mts); 0600, never committed
.judge.local

# A per-estate demo roster holds its people's CUSTODIAN KEYS (scripts/provision-estate-personas.mts writes it
# 0600). `*.local.json` above does not match `personas.<estate>.json`, and the one estate file that predates
# this pattern is already tracked — the next one is not.
demo/personas.*.json

# The Playwright suite's own output (`tests/e2e-sso/playwright.config.ts` → `outputDir: 'artifacts'`): traces
# and failure screenshots from a live run against production. The suite moved here 2026-10-13 and ap-demos
# never ignored these, so a failing run left them staged for whoever committed next.
tests/e2e-sso/artifacts/
tests/e2e-sso/test-results/
playwright-report/
.vercel
.env*
