{
  "name": "ap-home",
  "version": "0.0.0",
  "private": true,
  "description": "ap-home — Home: the person's / organization's agent and the Home that governs it (spec 234/310/348/398), on published @agenticprimitives/* packages (ADR-0063, spec 399 W2).",
  "type": "module",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=9"
  },
  "scripts": {
    "doctor": "ap doctor",
    "doctor:rules": "ap doctor --rules",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm test && ap doctor",
    "live-gates": "ap test --live-gates scripts/live-gates.json",
    "conform:a2a": "ap conform a2a",
    "conform:mcp": "ap conform mcp",
    "upgrade:canary": "ap upgrade --canary",
    "upgrade:pin": "ap upgrade --pin",
    "census": "tsx scripts/check-home-census.mts",
    "census:md": "tsx scripts/check-home-census.mts --write-md",
    "check:gate-fixture": "tsx scripts/check-gate-fixture.mts",
    "check:invitation-audit": "tsx scripts/check-invitation-audit.mts",
    "check:unknown-not-zero": "tsx scripts/check-unknown-not-zero.mts",
    "build:home": "pnpm --filter @ap-home/home build && node -e \"const fs=require('fs');const src='apps/home/dist';if(process.env.VERCEL&&fs.existsSync(src)&&!fs.existsSync('dist'))fs.cpSync(src,'dist',{recursive:true})\"",
    "build:component-registry": "tsx scripts/build-component-registry.mts",
    "check:component-registry": "tsx scripts/build-component-registry.mts --check",
    "check:home-kv-allowlist": "node scripts/check-home-kv-allowlist.mjs",
    "check:ask-truth": "tsx scripts/ask-truth.mts",
    "check:interaction-coverage": "tsx scripts/check-interaction-coverage.ts",
    "check:no-vector-over-vault": "tsx scripts/check-no-vector-over-vault.ts",
    "check:live-gates": "tsx scripts/live-gates.mts",
    "check:live-gates-trend": "tsx scripts/live-gates-trend.mts",
    "check:live-gates:runner": "tsx scripts/live-gates-runner.mts"
  },
  "devDependencies": {
    "@agenticprimitives/a2a": "0.0.0-alpha.30",
    "@agenticprimitives/devkit": "0.0.0-alpha.16",
    "@agenticprimitives/evaluation": "0.0.0-alpha.5",
    "@agenticprimitives/mcp-protocol": "0.0.0-alpha.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8",
    "tsx": "^4.22.4",
    "@agenticprimitives/ontology": "1.0.0-alpha.31",
    "viem": "2.52.2",
    "@playwright/test": "^1.49.0",
    "@agenticprimitives/agent-account": "1.0.0-alpha.31",
    "@agenticprimitives/agent-naming": "1.0.0-alpha.31",
    "@agenticprimitives/agent-profile": "1.0.0-alpha.31",
    "@agenticprimitives/agent-relationships": "1.0.0-alpha.31",
    "@agenticprimitives/capability-claims": "0.0.0-alpha.29",
    "@agenticprimitives/contracts": "1.0.0-alpha.31",
    "@agenticprimitives/delegation": "1.0.0-alpha.31",
    "@agenticprimitives/fabric": "0.0.0-alpha.20",
    "@agenticprimitives/key-custody": "1.0.0-alpha.31",
    "@agenticprimitives/orchestration": "0.0.0-alpha.10",
    "@agenticprimitives/registry-kit": "0.0.0-alpha.19",
    "@agenticprimitives/runtime-member": "0.0.0-alpha.9",
    "@agenticprimitives/types": "1.0.0-alpha.31"
  },
  "pnpm": {
    "overrides": {
      "typescript": "~5.7.0",
      "@types/react": "^19.2.16",
      "@types/react-dom": "^19.2.3",
      "esbuild": "^0.28.1",
      "undici": ">=8.10.2",
      "fast-uri": ">=4.1.3",
      "brace-expansion": ">=5.0.11",
      "ws": ">=8.21.0",
      "postcss": ">=8.5.18",
      "js-yaml": ">=4.3.0",
      "form-data": ">=4.0.6",
      "axios": ">=1.20.0",
      "ip-address": ">=10.3.1",
      "socket.io-parser": ">=4.2.7",
      "sharp": ">=0.35.4",
      "read-yaml-file>js-yaml": "^3.15.2",
      "nanoid@3": "^3.3.18"
    }
  },
  "packageManager": "pnpm@9.15.0"
}
