{
  "name": "@agenticprimitives-demo/edge",
  "version": "0.0.1-alpha.7",
  "private": true,
  "description": "Agentic Edge admission Worker (spec 288 §6): runs edge-runtime admission + edge-cloudflare adapter, serves /.well-known/agentic-authorization, and dispatches admitted bytes to demo-mcp/demo-a2a over Service Bindings. Owns no authority (ADR-0043).",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8789 --persist-to ../../.wrangler/state-edge",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agenticprimitives/agentic-authorization": "workspace:*",
    "@agenticprimitives/surface-catalog": "workspace:*",
    "@agenticprimitives/edge-cloudflare": "workspace:*",
    "@agenticprimitives/edge-runtime": "workspace:*",
    "@agenticprimitives/rate-control": "workspace:*",
    "@agenticprimitives/rate-control-cloudflare": "workspace:*",
    "@agenticprimitives/admission": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260604.1",
    "@types/node": "^22.7.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0",
    "vitest": "^4.1.8"
  }
}
