{
  "name": "@ap-home/edge",
  "version": "0.0.1-alpha.9",
  "private": true,
  "description": "Agentic Edge admission Worker (spec 288 §6): runs edge-runtime admission + edge-cloudflare adapter, serves /.well-known/agentic-authorization, and dispatches admitted bytes to demo-mcp/demo-a2a over Service Bindings. Owns no authority (ADR-0043).",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8789 --persist-to ../../.wrangler/state-edge",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agenticprimitives/agentic-authorization": "0.0.0-alpha.4",
    "@agenticprimitives/surface-catalog": "0.0.0-alpha.5",
    "@agenticprimitives/edge-cloudflare": "0.0.0-alpha.11",
    "@agenticprimitives/edge-runtime": "0.0.0-alpha.11",
    "@agenticprimitives/rate-control": "0.0.0-alpha.5",
    "@agenticprimitives/rate-control-cloudflare": "0.0.0-alpha.5",
    "@agenticprimitives/admission": "0.0.0-alpha.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260605.1",
    "@types/node": "22.19.19",
    "typescript": "5.7.3",
    "wrangler": "4.93.0",
    "vitest": "4.1.8"
  }
}
