auto-install-peers=true

# strict-peer-dependencies is OFF, and this is the reason — delete the line when it is no longer true.
#
# Vercel resolves FRESH on every build (the root lockfile is deliberately gitignored — see .gitignore: a
# committed one made pnpm link importers whose directories the build checkout lacks). So this repo is
# exposed to whatever the registry currently says, and eight published @agenticprimitives packages name a
# sibling version that is no longer current — `content-storage@1.0.0-alpha.4` still asks for
# `types@1.0.0-alpha.25`, `service-host@0.0.0-alpha.0` for `a2a@0.0.0-alpha.28`, and `model-client` /
# `model-gateway` went out with `workspace:*` unresolved. With strictness on, `pnpm install` exits 1 and
# NOTHING here deploys — faithnet's Home included, not just a new estate's.
#
# `pnpm.peerDependencyRules.allowedVersions` was tried first and is not enough: naming each mismatch
# silences the report but pnpm still exits 1.
#
# This is safe here and would not be in a library: every @agenticprimitives dependency in this repo is
# pinned EXACTLY, so the peer graph is not what decides which version is installed — the pin is. What
# strictness was catching is a Ring 0 release defect, and Ring 0 PR 710 republishes the eight packages.
# Turn this back on once that release lands and a fresh `pnpm install --no-frozen-lockfile` exits 0.
strict-peer-dependencies=false
